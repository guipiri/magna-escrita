# Variáveis de Ambiente - API (apps/api)

CORS_ORIGIN=http://localhost:3000,http://localhost:4173
PORT=3000
WORKER_PORT=8080

# Token de acesso do Mercado Pago
# Obtenha em: https://www.mercadopago.com.br/developers/credentials
MERCADOPAGO_ACCESS_TOKEN=seu_access_token_aqui

# Secret para validar a autenticidade das notificações Webhook do Mercado Pago
# Obtenha em: https://www.mercadopago.com.br/developers/credentials
MERCADOPAGO_WEBHOOK_SECRET=sua_webhook_secret_aqui

# Google OAuth (mock values - replace later)
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-google-client-secret

# JWT (mock values - replace later) - Expiration in milliseconds
JWT_SECRET=mock-jwt-secret
JWT_EXPIRES_IN=604800000

# Auth cookie settings
AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_MAX_AGE_DAYS=7

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname?schema=public

# Gemini API
GEMINI_API_KEY=seu_gemini_api_key_aqui

# Cloudflare R2 Storage
CLOUDFLARE_R2_ACCOUNT_ID=seu_account_id_aqui
CLOUDFLARE_R2_ACCESS_KEY_ID=seu_access_key_id_aqui
CLOUDFLARE_R2_SECRET_ACCESS_KEY=seu_secret_access_key_aqui
CLOUDFLARE_R2_BUCKET_NAME=nome_do_bucket
CLOUDFLARE_R2_PUBLIC_URL=https://sua-url-publica.r2.dev

# Mail SMTP settings
SMTP_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# Redis settings
REDIS_URL=rediss://localhost:6379

