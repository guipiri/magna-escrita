// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  APPROVED
  CANCELED
  REFUNDED
}

enum Role {
  ADMIN
  SCHOOL
  CUSTOMER
}

model Order {
  id                   String      @id @default(cuid())
  mpId                 String      @unique
  status               OrderStatus @default(PENDING)
  paymentMethod        String
  paymentMethodDetail  String?
  totalAmount          Decimal     @db.Decimal(10, 2)
  email                String
  userId               String
  user                 User        @relation(fields: [userId], references: [id])
  identificationType   String?
  identificationNumber String?
  token                String?
  installments         Int
  issuerId             String?
  items                OrderItem[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model Price {
  id     String  @id @default(cuid())
  amount Decimal @db.Decimal(10, 2)
  books  Book[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookStatus {
  DRAFT
  REVISED_BY_SCHOOL // REVISED BY SCHOOL AND READY TO BE REVISED BY MAGNA
  READY // READY FOR SALE AND PRINT
  ARCHIVED // NOT FOR SALE
}

model Book {
  id           String  @id @default(cuid())
  magnificCode String  @unique
  title        String?
  author       String?
  synopsis     String?
  pages        Page[]
  priceId      String
  price        Price   @relation(fields: [priceId], references: [id])

  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  orderItems OrderItem[]

  authographsEvent   AuthographsEvent @relation(fields: [authographsEventId], references: [id])
  authographsEventId String

  status BookStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, authographsEventId])
}

model BookTemplate {
  id   String @id @default(cuid())
  name String

  bookTemplatePages BookTemplatePage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes Class[]
}

model BookTemplatePage {
  pageNumber Int
  pageType   PageType

  bookTemplateId String
  bookTemplate   BookTemplate @relation(fields: [bookTemplateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([bookTemplateId, pageNumber])
}

model OrderItem {
  orderId  String
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId   String
  book     Book    @relation(fields: [bookId], references: [id])
  quantity Int
  amount   Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, bookId])
}

enum PageType {
  COVER
  TEXT
  DRAW
  DRAW_TEXT
  BLANK
  PREFACE
  THANKS
  BACK_COVER
}

enum PageStatus {
  NOT_STARTED
  IN_PROGRESS
  REVISED_BY_SCHOOL
  READY
}

model Page {
  number           Int
  type             PageType
  status           PageStatus @default(NOT_STARTED)
  textContent      String?
  drawImageUrl     String?
  originalImageUrl String?
  imageUrl         String?
  book             Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId           String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([bookId, number])
}

model UserUnit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, unitId])
}

model Student {
  id   String @id @default(cuid())
  name String
  age  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId String
  books   Book[]
}

enum SchoolYear {
  YEAR_2026 @map("2026")
  YEAR_2027 @map("2027")
}

model Class {
  id          String    @id @default(cuid())
  name        String
  teacherName String
  units       Unit      @relation(fields: [unitId], references: [id])
  unitId      String
  students    Student[]

  schoolYear SchoolYear

  bookTemplateId String
  bookTemplate   BookTemplate @relation(fields: [bookTemplateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthographsEventTimeline {
  id      String           @id @default(cuid())
  date    DateTime
  details String?
  eventId String
  event   AuthographsEvent @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AuthographsEventStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELED
}

model AuthographsEvent {
  id         String     @id @default(cuid())
  name       String
  date       DateTime
  schoolYear SchoolYear

  status AuthographsEventStatus @default(PLANNED)

  timeline AuthographsEventTimeline[]
  books    Book[]

  unit   Unit?   @relation(fields: [unitId], references: [id])
  unitId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unit {
  id      String  @id @default(cuid())
  name    String?
  logoUrl String?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  classes Class[]

  userUnits UserUnit[]

  authographsEvents AuthographsEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model School {
  id        String   @id @default(cuid())
  name      String
  units     Unit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       String     @id @default(cuid())
  googleId String     @unique
  email    String     @unique
  name     String?
  picture  String?
  role     Role       @default(CUSTOMER)
  orders   Order[]
  units    UserUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
